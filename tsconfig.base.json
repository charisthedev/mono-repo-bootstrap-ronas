{
  "compilerOptions": {
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@mono-repo-ronas-bootstrap/source"],
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "jsx": "react-native",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": false,
    "strictNullChecks": true,
    "paths": {
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/utils/app-env": [
        "libs/test-app-mobile/shared/utils/app-env/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/data-access/storage": [
        "libs/test-app-mobile/shared/data-access/storage/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/ui/styles": [
        "libs/test-app-mobile/shared/ui/styles/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/utils/navigation": [
        "libs/test-app-mobile/shared/utils/navigation/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/data-access/store": [
        "libs/test-app-mobile/shared/data-access/store/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/data-access/api-client": [
        "libs/test-app-mobile/shared/data-access/api-client/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/utils/form": [
        "libs/test-app-mobile/shared/utils/form/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/ui/ui-kit": [
        "libs/test-app-mobile/shared/ui/ui-kit/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/utils/toast-service": [
        "libs/test-app-mobile/shared/utils/toast-service/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/data-access/api": [
        "libs/test-app-mobile/shared/data-access/api/src/index.ts"
      ],
      "@mono-repo-ronas-bootstrap/test-app-mobile/shared/data-access/auth": [
        "libs/test-app-mobile/shared/data-access/auth/src/index.ts"
      ]
    }
  },
  "exclude": ["**/*.cjs", "**/*.mjs", "node_modules", "dist"]
}
